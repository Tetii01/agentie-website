# Copiază fișierul ăsta în .env.local (local) și setează aceleași variabile pe Vercel
# (Project → Settings → Environment Variables).
#
# Fără ele, formularul nu crapă: în development afișează în consolă ce s-ar fi trimis;
# în producție, dacă lead-ul nu ajunge nicăieri, utilizatorul vede mesajul de eroare cu WhatsApp.

# Cheia API Resend (resend.com → API Keys)
RESEND_API_KEY=

# Adresa care primește lead-urile. Mai multe adrese: separate prin virgulă.
LEAD_TO_EMAIL=

# Expeditorul, de pe un domeniu verificat în Resend. Ex.: Site <lead@domeniu.ro>
LEAD_FROM_EMAIL=

# Opțional: webhook care primește fiecare lead ca JSON (n8n, CRM etc.)
LEAD_WEBHOOK_URL=
